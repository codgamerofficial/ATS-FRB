# Supabase Configuration for React Native App
# REPLACE WITH YOUR ACTUAL SUPABASE CREDENTIALS - NEVER COMMIT REAL KEYS TO VCS!
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App Configuration
EXPO_PUBLIC_APP_NAME=ATS Resume Builder
EXPO_PUBLIC_APP_VERSION=1.0.0

# Instructions:
# 1. Create a Supabase project at https://supabase.com
# 2. Copy your project URL and anon key from Settings > API
# 3. Replace the placeholder values above with your real credentials
# 4. Rename this file to .env
# 5. NEVER commit .env to version control (it should be in .gitignore)

# Note: These are the public credentials for Expo environment variables.
# They will be bundled with your mobile app and are safe to use.
# The EXPO_PUBLIC_ prefix makes them accessible in the client-side code.